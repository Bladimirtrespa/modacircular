# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO - PLATAFORMA DE INTERCAMBIO DE ROPA SOSTENIBLE
# ==============================================================================

# Entorno de Flask (desarrollo, pruebas, produccion)
FLASK_APP=run.py
FLASK_ENV=desarrollo
CLAVE_SECRETA=clave_secreta_super_segura_para_desarrollo_cambiar_en_produccion

# Configuración del Motor de Base de Datos Microsoft SQL Server
DB_SERVIDOR=localhost
DB_NOMBRE=DB_IntercambioRopa
DB_CONTROLADOR=ODBC Driver 17 for SQL Server

# Modalidad de Autenticación de SQL Server:
# Si usas Autenticación de Windows (recomendado en entornos locales), define: DB_AUTENTICACION_WINDOWS=si
DB_AUTENTICACION_WINDOWS=si

# Si usas Autenticación con Usuario y Contraseña de SQL Server (ej. sa), descomenta:
# DB_AUTENTICACION_WINDOWS=no
# DB_USUARIO=sa
# DB_CONTRASENA=tu_contrasena_aqui

# Almacenamiento de Evidencia Multimedia (Fotos y Videos)
CARPETA_SUBIDAS=app/static/uploads
LIMITE_MAXIMO_SUBIDA_MB=32
